---
// =============================================================
// PodcastEmbed - intègre un lecteur de podcast / audio
//
// Volontairement générique : les hébergeurs de podcast (Spotify,
// Ausha, Acast, Ivoox, RSS.com…) fournissent tous une URL d'iframe.
// Collez cette URL dans `src`. Un lien de partage Spotify
// (open.spotify.com/episode/…) est converti tout seul.
//
// Usage MDX :
//   <PodcastEmbed
//     src="https://open.spotify.com/embed/episode/xxxx"
//     title="Épisode 1 - L'accessibilité web"
//   />
// =============================================================
interface Props {
  /** URL du lecteur embarqué fournie par l'hébergeur du podcast. */
  src: string;
  /** Titre accessible du lecteur. */
  title?: string;
  /** Hauteur de l'iframe en pixels (152 = format compact courant). */
  height?: number;
  /** Légende optionnelle sous le lecteur. */
  caption?: string;
}
const { src: rawSrc, title = 'Lecteur de podcast', height = 152, caption } = Astro.props;

/**
 * Le lien de PARTAGE Spotify (open.spotify.com/episode/…) refuse d'être
 * affiché dans une iframe : seule l'URL d'intégration (/embed/…) le peut.
 * C'est pourtant le lien qu'on copie le plus naturellement - on le convertit
 * donc, en retirant au passage le traceur `?si=`.
 */
const spotify = rawSrc.match(/^https:\/\/open\.spotify\.com\/(episode|show)\/([A-Za-z0-9]+)/);
const src = spotify ? `https://open.spotify.com/embed/${spotify[1]}/${spotify[2]}` : rawSrc;
---

<figure class="c-podcast">
  <iframe
    class="c-podcast__iframe"
    style={`height: ${height}px;`}
    src={src}
    title={title}
    loading="lazy"
    allow="autoplay; clipboard-write; encrypted-media; picture-in-picture"
    referrerpolicy="strict-origin-when-cross-origin"
  ></iframe>
  {caption && <figcaption class="c-podcast__caption">{caption}</figcaption>}
</figure>
